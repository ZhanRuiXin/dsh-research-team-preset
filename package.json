{
  "name": "dsh-research-team-preset",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "description": "A DSH agent preset that turns one session into a small, coordinated research team; 科研团队模式，覆盖文献、数据、设计、实现、实验、复核与论文产出的端到端科研协作。",
  "exports": {
    ".": "./settings/index.js",
    "./tool": "./plugin/index.js",
    "./modeled-teammates": "./plugin/modeled-teammates.js",
    "./settings": "./settings/index.js",
    "./client": "./client/index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test test/modeled-teammates.test.js test/workspace-init.test.js test/scope-check.test.js test/settings-route.test.js test/architecture.test.js test/worklog.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhanRuiXin/dsh-research-team-preset.git"
  },
  "homepage": "https://github.com/ZhanRuiXin/dsh-research-team-preset#readme",
  "bugs": {
    "url": "https://github.com/ZhanRuiXin/dsh-research-team-preset/issues"
  },
  "author": {
    "name": "Ruixin Zhan",
    "email": "zhan-ruixin@qq.com"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-plugins",
    "agent-preset",
    "agent-teams",
    "research-team",
    "multi-agent",
    "research-workflow"
  ],
  "files": [
    "cordis.patch.yml",
    "plugin/",
    "settings/",
    "client/",
    "panel/",
    "docs/",
    "README.md",
    "DEVELOPMENT.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  }
}
